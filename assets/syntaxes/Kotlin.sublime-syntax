%YAML 1.2
---
name: Kotlin
file_extensions: [kt, kts]
scope: source.kotlin
contexts:
  main:
    - match: //
      push:
        - meta_scope: comment.line.double-slash.kotlin
        - match: $\n?
          pop: true
    - match: /\*
      push:
        - meta_scope: comment.block.kotlin
        - match: \*/
          pop: true
    - match: '"""'
      push:
        - meta_scope: string.quoted.triple.kotlin
        - match: '"""'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.kotlin
        - match: \\.
          scope: constant.character.escape.kotlin
        - match: '\$\{'
          push:
            - meta_scope: meta.interpolation.kotlin
            - match: '\}'
              pop: true
            - include: main
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.kotlin
        - match: \\.
          scope: constant.character.escape.kotlin
        - match: "'"
          pop: true
    - match: \b(0[xX][0-9a-fA-F_]+|\d[\d_]*(\.[\d_]+)?([eE][+-]?\d+)?)[fFLlUu]*\b
      scope: constant.numeric.kotlin
    - match: \b(true|false|null)\b
      scope: constant.language.kotlin
    - match: \b(package|import)\b
      scope: keyword.control.import.kotlin
    - match: \b(if|else|when|for|while|do|return|break|continue|throw|try|catch|finally|in|is|as)\b
      scope: keyword.control.kotlin
    - match: \b(fun|val|var|class|object|interface|typealias|constructor|init|companion|enum|data|sealed|annotation|this|super|by|where)\b
      scope: keyword.kotlin
    - match: \b(private|protected|public|internal|open|final|abstract|override|lateinit|inline|suspend|const|vararg|reified|operator|infix|tailrec|external|expect|actual)\b
      scope: storage.modifier.kotlin
    - match: \b(Int|Long|Short|Byte|Float|Double|Boolean|Char|String|Unit|Any|Nothing|Array|List|Map|Set|MutableList|MutableMap|MutableSet)\b
      scope: support.type.kotlin
    - match: '@[A-Za-z_][\w]*'
      scope: variable.annotation.kotlin
    - match: \b([A-Z][A-Za-z0-9_]*)\b
      scope: entity.name.type.kotlin
    - match: \b([a-z_][\w]*)\s*(?=\()
      scope: entity.name.function.kotlin
    - match: '[=+\-*/%<>!&|^~?:]+'
      scope: keyword.operator.kotlin
    - match: '[{}()\[\];,.]'
      scope: punctuation.kotlin
