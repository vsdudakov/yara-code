%YAML 1.2
---
name: TypeScript
file_extensions: [ts, tsx, mts, cts, jsx]
scope: source.ts
contexts:
  main:
    - include: comments
    - include: strings
    - match: \b(0[xX][0-9a-fA-F_]+|\d[\d_]*(\.[\d_]+)?([eE][+-]?\d+)?)n?\b
      scope: constant.numeric.ts
    - match: \b(true|false|null|undefined|NaN|Infinity)\b
      scope: constant.language.ts
    - match: \b(import|export|from|as|default|require)\b
      scope: keyword.control.import.ts
    - match: \b(if|else|for|while|do|switch|case|break|continue|return|throw|try|catch|finally|yield|await|of|in)\b
      scope: keyword.control.ts
    - match: \b(const|let|var|function|class|interface|type|enum|namespace|module|declare|abstract|implements|extends|new|delete|typeof|instanceof|void|this|super|satisfies|keyof|infer|asserts)\b
      scope: keyword.ts
    - match: \b(public|private|protected|readonly|static|async|get|set|override)\b
      scope: storage.modifier.ts
    - match: \b(string|number|boolean|any|unknown|never|object|symbol|bigint|Array|Promise|Record|Partial|Readonly|Map|Set)\b
      scope: support.type.ts
    - match: '@[A-Za-z_$][\w$]*'
      scope: variable.annotation.ts
    - match: \b([A-Z][A-Za-z0-9_$]*)\b
      scope: entity.name.type.ts
    - match: \b([a-zA-Z_$][\w$]*)\s*(?=\()
      scope: entity.name.function.ts
    - match: '[=+\-*/%<>!&|^~?:]+'
      scope: keyword.operator.ts
    - match: '[{}()\[\];,.]'
      scope: punctuation.ts
  comments:
    - match: //
      scope: punctuation.definition.comment.ts
      push:
        - meta_scope: comment.line.double-slash.ts
        - match: $\n?
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.ts
      push:
        - meta_scope: comment.block.ts
        - match: \*/
          pop: true
  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.ts
      push:
        - meta_scope: string.quoted.double.ts
        - match: \\.
          scope: constant.character.escape.ts
        - match: '"'
          pop: true
    - match: "'"
      scope: punctuation.definition.string.begin.ts
      push:
        - meta_scope: string.quoted.single.ts
        - match: \\.
          scope: constant.character.escape.ts
        - match: "'"
          pop: true
    - match: '`'
      scope: punctuation.definition.string.begin.ts
      push:
        - meta_scope: string.quoted.other.ts
        - match: \\.
          scope: constant.character.escape.ts
        - match: '\$\{'
          scope: punctuation.section.interpolation.begin.ts
          push:
            - meta_scope: meta.interpolation.ts
            - match: '\}'
              pop: true
            - include: main
        - match: '`'
          pop: true
