# AUR package, rendered by .github/workflows/release.yml.
# Maintainer: Seva D <vsdudakov@gmail.com>
pkgname=ycode-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="The terminal editor for the agent loop: your coding agent beside the diff of what it did"
arch=('x86_64' 'aarch64')
url="https://github.com/vsdudakov/yara-code"
license=('MIT')
provides=('ycode')
conflicts=('ycode')
source_x86_64=("https://github.com/vsdudakov/yara-code/releases/download/@TAG@/ycode-@TAG@-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/vsdudakov/yara-code/releases/download/@TAG@/ycode-@TAG@-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@LINUX_SHA@')
sha256sums_aarch64=('@LINUX_ARM_SHA@')

package() {
  cd "ycode-@TAG@-$CARCH-unknown-linux-gnu"
  install -Dm755 ycode "$pkgdir/usr/bin/ycode"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ycode/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ycode/LICENSE"
}
