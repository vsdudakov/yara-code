<?xml version="1.0" encoding="UTF-8"?>
<!--
  The bundle's own description, rendered by packaging/macos/bundle.sh.
  A window frontend started from a bundle is an application to macOS: it takes
  the Dock, it takes the menu bar, and it is what the name in that bar says.
  The same binary started from a shell is only a process, which is why the
  terminal frontend needs none of this.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>ycode-gui</string>
  <key>CFBundleIconFile</key>
  <string>yara</string>
  <key>CFBundleIdentifier</key>
  <string>com.vsdudakov.ycode</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Yara Code</string>
  <key>CFBundleDisplayName</key>
  <string>Yara Code</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <!--
    No CFBundleDocumentTypes: the window reads the folder it is given on the
    command line, and a bundle is not handed one that way — Finder sends an
    open event instead, which nothing here listens for yet. Claiming the types
    without answering them would put Yara Code in "Open With" and then do
    nothing when it was chosen.
  -->
</dict>
</plist>
